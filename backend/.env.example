# =============================================================================
# BigTeam Backend Environment Variables
# =============================================================================
# SECURITY WARNING: Never commit actual credentials to version control!
# Copy this file to .env and fill in your actual values.
# =============================================================================

# Database Configuration
DB_URL=postgresql://username:password@host:port/database
DB_HOST=your-supabase-host.supabase.co
DB_NAME=postgres
DB_USER=postgres
DB_PASS=your-database-password
DB_PORT=5432

# Supabase Configuration
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_KEY=your-supabase-service-role-key

# =============================================================================
# JWT Configuration - SECURITY CRITICAL
# =============================================================================
# IMPORTANT: Generate a cryptographically secure secret key!
# Use: python -c "import secrets; print(secrets.token_hex(64))"
# Minimum 64 characters (128 hex chars recommended)
JWT_SECRET_KEY=GENERATE_SECURE_KEY_USING_COMMAND_ABOVE

# Token expiration in seconds
JWT_ACCESS_TOKEN_EXPIRES=3600       # 1 hour (recommended for security)
JWT_REFRESH_TOKEN_EXPIRES=604800    # 7 days

# =============================================================================
# Application Configuration
# =============================================================================
FLASK_ENV=production

# Frontend URL (for CORS - no wildcards in production!)
FRONTEND_URL=https://your-frontend.vercel.app

# Optional: Redis Configuration (recommended for production token blacklisting)
REDIS_URL=redis://localhost:6379
